# Phase 1 services
DATABASE_URL=postgresql://omen:omen@localhost:5432/omen
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
LOG_PRETTY=true

# Phase 0 / optional Polymarket auth
# Direct EOA-backed Polymarket account
POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Optional for proxy / funder-backed Polymarket setups
# POLY_SIGNATURE_TYPE=2
# POLY_FUNDER=0xYOUR_POLYMARKET_FUNDER_ADDRESS

# Optional pre-derived Polymarket CLOB API credentials
# POLY_API_KEY=
# POLY_API_SECRET=
# POLY_API_PASSPHRASE=
